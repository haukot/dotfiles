[user]
	name = Dmitry Davydov
	email = haudvd@gmail.com
	signingKey = /home/haukot/.ssh/id_rsa.pub
[alias]
	st = status -sb
	ci = commit
	co = checkout
	cim = commit -m
  ame = commit --amend
  graph = "log --all --graph --pretty=format:'%Cred%h%Creset%x09%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative"
  hist = log --all --graph --decorate=full --date-order --color
  dif = diff -C --stat -p
  difc = diff -C --stat -p --cached
  put = push origin HEAD
  up = pull --rebase
  mr = lab merge-request
  dad = "! echo '      ARE YA WINNING, SON?\n ⢸⠉⠉⠉⠉⠉⠉⠉⠉⠉⠉⠉⠉⠉⠉⠉⠉⠉⡷⠑⢦⡀⠀⠀⠀⠀⠀\n ⢸⠀  ⠀⠀⠀⢀⠖⠒⠒⠒⢤⠀⠀⠀ ⠀⡇⠀⠀⠀⠙⢦⡀⠀⠀⠀⠀\n ⢸⠀  ⠀⣀⢤⣼⣀⡠⠤⠤⠼⠤⡄⠀ ⠀⡇⠀⠀⠀⠀⠀⠙⢄⠀⠀⠀⠀\n ⢸⠀  ⠀⠑⡤⠤⡒⠒⠒⡊⠙⡏⠀⢀⠀ ⡇⠀⠀⠀⠀⠀⠀⠀⠑⠢⡄⠀\n ⢸⠀  ⠀⠀⠇⠀⢄⣀⣀⣀⢀⠧⠟⠁⠀ ⡇⠀⠀⠀⠀⠀⠀⠀⠀⠀⢸⠀\n ⢸⠀  ⠀⠀⠸⣀⠀⠀⠈⢉⠟⠓⠀⠀⠀⠀⡇⠀⠀⠀⠀⠀⠀⠀⠀⠀⢸\n ⢸⠀  ⠀⠀⠀⠈⢱⡖⠋⠁⠀⠀⠀⠀⠀⠀⡇⠀⠀⠀⠀⠀⠀⠀⠀⠀⢸\n ⢸⠀  ⠀⠀⠀⣠⢺⠧⢄⣀⠀⠀⣀⣀⠀⠀⡇⠀⠀⠀⠀⠀⠀⠀⠀⠀⢸\n ⢸⠀  ⠀⠀⣠⠃⢸⠀⠀⠈⠉⡽⠿⠯⡆⠀⡇⠀⠀⠀⠀⠀⠀⠀⠀⠀⢸\n ⢸⠀  ⠀⣰⠁⠀⢸⠀⠀⠀⠀⠉⠉⠉⠀⠀⡇⠀⠀⠀⠀⠀⠀⠀⠀⠀⢸\n ⢸⠀  ⠀⠣⠀⠀⢸⢄⠀⠀⠀⠀⠀⠀⠀⠀⡇⠀⠀⠀⠀⠀⠀⠀⠀⠀⢸\n ⢸⠀  ⠀⠀⠀⠀⢸⠀⢇⠀⠀⠀⠀⠀⠀⠀⡇⠀⠀⠀⠀⠀⠀⠀⠀⠀⢸\n ⢸⠀  ⠀⠀⠀⠀⡌⠀⠈⡆⠀⠀⠀⠀⠀⠀⡇⠀⠀⠀⠀⠀⠀⠀⠀⠀⢸\n ⢸⠀  ⠀⠀⠀⢠⠃⠀⠀⡇⠀⠀⠀⠀⠀⠀⡇⠀⠀⠀⠀⠀⠀⠀⠀⠀⢸\n ⢸⠀  ⠀⠀⠀⢸⠀⠀⠀⠁⠀⠀⠀⠀⠀⠀⠷         ⢸\n '"
	sto = "!f() { git reset --soft \"$1\"^ && git commit -C \"$1\"; }; f" # squash-to, merge commits to target

  feat = flow feature
  hot = flow hotfix
  rels = flow release
[color]
   	ui = auto
[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green
[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold
	whitespace = red reverse
[color "status"]
	added = yellow
	changed = green
	untracked = cyan
[push]
	default = simple
[credential]
	helper = store
[core]
	excludesfile = /home/haukot/.gitignore_global
[safe]
	directory = /media/fastwindata/ObsidianNotesVault/ObsidianNotesVault
	directory = /media/fastwindata/ObsidianNotesVault/NewVault
	directory = /media/fastwindata/ObsidianNotesVault/Cybermango
[commit]
	gpgsign = true
[gpg]
	format = ssh
