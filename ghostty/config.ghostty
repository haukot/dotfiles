# Let Herdr handle workspace and tab shortcuts.
keybind = ctrl+shift+n=unbind
keybind = ctrl+shift+q=unbind
keybind = ctrl+tab=unbind
keybind = ctrl+shift+tab=unbind
keybind = ctrl+shift+t=unbind
keybind = ctrl+shift+w=unbind

# Match GNOME Terminal's Yaru theme colors and profile palette.
background = #300a24
foreground = #ffffff
window-theme = dark
palette = 0=#524520
palette = 1=#c01c28
palette = 2=#26a269
palette = 3=#a2734c
palette = 4=#268bd2
palette = 5=#a347ba
palette = 6=#2aa1b3
palette = 7=#d0cfcc
palette = 8=#5e5c64
palette = 9=#f66151
palette = 10=#33d17a
palette = 11=#e9ad0c
palette = 12=#2a7bde
palette = 13=#c061cb
palette = 14=#33c7de
palette = 15=#ffffff
